rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonGuestUser() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isNonGuestUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }

    // ============ USERS ============
    match /users/{userId} {
      // Lectura: dueño, admin, empresas viendo talento, o perfiles públicos/de empresa
      allow read: if isOwner(userId) || (
        isNonGuestUser() && (
          hasRole('admin') ||
          hasRole('company') ||
          resource == null ||
          resource.data.get('isPublic', false) == true ||
          resource.data.role == 'company'
        )
      );

      // Creación: registro de estudiante/empresa (sin escalación a admin) o creación por admin
      allow create: if (
        isOwner(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role in ['student', 'company'] &&
        request.resource.data.get('isVerified', false) == false
      ) || (
        hasRole('admin') &&
        request.resource.data.id == userId &&
        request.resource.data.role in ['student', 'company', 'admin']
      );

      // Actualización controlada según política Append-Only + roles
      allow update: if (
        // El dueño puede actualizar sus datos de perfil (sin alterar role, id ni isVerified)
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photoUrl', 'isActive', 'isPublic', 'skills',
                    'experience', 'portfolio', 'resumeUrl', 'phone', 'address',
                    'availability', 'university', 'career', 'semester', 'gpa',
                    'companyName', 'industry', 'companySize', 'website',
                    'description', 'nit', 'contactPerson', 'contactPosition',
                    'updatedAt'])
      ) || (
        // El administrador puede aprobar verificaciones o suspender/activar cuentas
        hasRole('admin') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isActive', 'isVerified', 'role', 'updatedAt'])
      ) || (
        // Recálculo de reputación tras reseña válida
        isNonGuestUser() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratingAverage', 'ratingsCount', 'updatedAt']) &&
        request.resource.data.ratingAverage >= 1 &&
        request.resource.data.ratingAverage <= 5 &&
        request.resource.data.ratingsCount >= 1
      );

      // Política Append-Only: prohibido eliminar usuarios
      allow delete: if false;
    }

    // ============ PROJECTS (Vacantes) ============
    match /projects/{projectId} {
      // Lectura: vacantes activas visibles públicamente en Landing, el resto para usuarios autenticados
      allow read: if resource == null ||
        resource.data.status == 'active' ||
        isAuthenticated();

      // Creación: empresas verificadas/activas o admin creando vacante activa
      allow create: if isNonGuestUser() && (
        (hasRole('company') && request.resource.data.companyId == request.auth.uid) ||
        hasRole('admin')
      ) && request.resource.data.status == 'active';

      // Actualización:
      allow update: if isNonGuestUser() && (
        // La empresa dueña o admin puede editar campos permitidos y estado
        ((resource.data.companyId == request.auth.uid || hasRole('admin')) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'category', 'type', 'location',
                      'modality', 'salary', 'skillsRequired', 'requirements',
                      'benefits', 'minExperience', 'maxExperience', 'status',
                      'closingDate', 'career', 'duration', 'deliverables',
                      'applicationsCount', 'updatedAt'])) ||
        // Estudiante postulándose incrementa únicamente el contador
        (hasRole('student') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['applicationsCount', 'updatedAt']) &&
          request.resource.data.applicationsCount > resource.data.get('applicationsCount', 0))
      );

      // Política Append-Only: las vacantes no se eliminan físicamente, se desactivan/cierran
      allow delete: if false;
    }

    // ============ APPLICATIONS ============
    match /applications/{applicationId} {
      // Lectura: estudiante dueño, empresa dueña o administrador
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        hasRole('admin')
      );

      // Creación: estudiante autenticado creando su postulación en estado inicial pendiente
      allow create: if hasRole('student') &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Actualización:
      allow update: if isNonGuestUser() && (
        // Empresa o admin gestiona estados, hitos escrow, feedback y emisión de certificado
        ((resource.data.companyId == request.auth.uid || hasRole('admin')) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'escrowStage', 'certificateId',
                      'completedAt', 'feedback', 'updatedAt'])) ||
        // Estudiante en desarrollo puede cargar enlace de entregable para pasar a revisión
        (resource.data.studentId == request.auth.uid &&
          resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliverableUrl', 'deliverableNotes', 'deliverableSubmittedAt',
                      'escrowStage', 'updatedAt']) &&
          request.resource.data.get('escrowStage', 'in_progress') in ['funded', 'in_progress', 'review'])
      );

      // Política Append-Only: no eliminar postulaciones
      allow delete: if false;
    }

    // ============ NOTIFICATIONS ============
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid);

      allow create: if isNonGuestUser() &&
        request.resource.data.userId is string;

      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);

      allow delete: if false;
    }

    // ============ FAVORITES ============
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.studentId == request.auth.uid);

      allow create: if hasRole('student') &&
        request.resource.data.studentId == request.auth.uid;

      allow update, delete: if isNonGuestUser() &&
        resource.data.studentId == request.auth.uid;
    }

    // ============ SAVED PROFILES ============
    match /savedProfiles/{savedProfileId} {
      allow read: if isNonGuestUser() &&
        (resource == null || resource.data.companyId == request.auth.uid || hasRole('admin'));

      allow create, update: if hasRole('company') &&
        request.resource.data.companyId == request.auth.uid;

      allow delete: if hasRole('company') &&
        resource.data.companyId == request.auth.uid;
    }

    // ============ STUDENT PROFILES ============
    match /student_profiles/{profileId} {
      allow read: if isNonGuestUser() && (
        isOwner(profileId) ||
        hasRole('company') ||
        hasRole('admin') ||
        resource == null ||
        resource.data.get('isPublic', false) == true
      );

      allow write: if isOwner(profileId);
    }

    // ============ CONVERSATIONS & MESSAGES ============
    match /conversations/{conversationId} {
      allow get: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.participants);

      allow list: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      allow create: if isNonGuestUser() &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isNonGuestUser() &&
        request.auth.uid in resource.data.participants;

      allow delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isNonGuestUser() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

      allow create: if isNonGuestUser() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isNonGuestUser() && (
        resource == null ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.get('receiverId', '')
      );

      allow create: if isNonGuestUser() &&
        request.resource.data.senderId == request.auth.uid;

      allow update, delete: if false;
    }

    // ============ COMPANIES ============
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('company') && companyId == request.auth.uid;
      allow update: if isOwner(companyId) || hasRole('admin');
      allow delete: if false;

      match /savedProfiles/{savedProfileId} {
        allow read, write: if hasRole('company') && companyId == request.auth.uid;
      }
    }

    // ============ CERTIFICATES ============
    match /certificates/{certificateId} {
      // Lectura pública para verificación por empleadores (/verify/:id)
      allow read: if true;

      // Creación autorizada exclusivamente para empresas o administradores
      allow create: if isNonGuestUser() &&
        (hasRole('company') || hasRole('admin')) &&
        request.resource.data.verificationCode == certificateId;

      // Inmutabilidad académica garantizada
      allow update, delete: if false;
    }

    // ============ REVIEWS ============
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();

      allow create: if isNonGuestUser() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow update, delete: if false;
    }

    // ============ SUPPORT TICKETS (PQRS) ============
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        hasRole('admin')
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if hasRole('admin') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNotes', 'updatedAt']);

      allow delete: if false;
    }
  }
}
